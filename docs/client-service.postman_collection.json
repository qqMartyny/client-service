        {
          "name": "Обновить клиента → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"данные обновились\", () => {",
                  "    pm.expect(body.fullName).to.eql(\"Иванов Иван Петрович\");",
                  "    pm.expect(body.status).to.eql(\"INACTIVE\");",
                  "});",
                  "pm.test(\"createdAt не изменился\", () =>",
                  "    pm.expect(body.createdAt).to.eql(pm.collectionVariables.get(\"createdAt\")));",
                  "pm.test(\"updatedAt изменился\", () => pm.expect(body.updatedAt).to.not.eql(body.createdAt));",
                  "",
                  "pm.collectionVariables.set(\"updatedAt\", body.updatedAt);"
                ]
              }
            }
          ],

{
  "info": {
    "_postman_id": "6f0f6a8e-3b1d-4b8e-9a51-2f1c0c5e7a10",
    "name": "client-service",
    "description": "Проверка API сервиса учёта клиентов. Спецификация: docs/specification.md.\n\nЗапуск: Run collection. Папки и запросы выполняются по порядку и зависят друг от друга через переменную clientId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Основной сценарий (CRUD)",
      "description": "Запросы зависят друг от друга: create сохраняет clientId, остальные его используют. Запускать по порядку.",
      "item": [
        {
          "name": "Создать клиента → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"status = ACTIVE\", () => pm.expect(body.status).to.eql(\"ACTIVE\"));",
                  "pm.test(\"данные из запроса сохранены\", () => {",
                  "    pm.expect(body.fullName).to.eql(\"Иванов Иван Иванович\");",
                  "    pm.expect(body.gender).to.eql(\"M\");",
                  "});",
                  "pm.test(\"createdAt = updatedAt\", () => pm.expect(body.createdAt).to.eql(body.updatedAt));",
                  "pm.test(\"время в UTC\", () => pm.expect(body.createdAt).to.match(/Z$/));",
                  "pm.test(\"Location ведёт на созданного клиента\", () =>",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/api/clients/\" + body.id + \"$\")));",
                  "",
                  "pm.collectionVariables.set(\"clientId\", body.id);",
                  "pm.collectionVariables.set(\"createdAt\", body.createdAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"fullName\": \"Иванов Иван Иванович\",\n    \"gender\": \"M\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Список клиентов → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"ответ — массив\", () => pm.expect(body).to.be.an(\"array\"));",
                  "pm.test(\"созданный клиент есть в списке\", () => {",
                  "    const id = Number(pm.collectionVariables.get(\"clientId\"));",
                  "    pm.expect(body.some(c => c.id === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            }
          }
        },
